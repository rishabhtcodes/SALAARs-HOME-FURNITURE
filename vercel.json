{
  "version": 2,
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(?<file>.*)",
      "dest": "config/wsgi.py",
      "headers": {
        "cache-control": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ]
}
